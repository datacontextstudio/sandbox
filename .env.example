# Copy to .env and adjust as needed.
#
# To use a natively-installed Ollama (for Apple Silicon GPU acceleration):
#   1. brew install ollama && ollama serve
#   2. Set OLLAMA_BASE_URL below and remove/comment the ollama service in docker-compose.yml

# OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434  # use this for native Ollama

# LLM model for chat and title generation (must support tool calling for MCP)
# For 8 GB M1: use llama3.2:3b (~2 GB). For 16 GB M1: llama3.1 (~5 GB).
LLM_MODEL=llama3.1

QDRANT_HOST=qdrant
QDRANT_PORT=6333

VALKEY_URL=redis://valkey:6379

# Chunking defaults (worker only)
# CHUNK_SIZE=4000
# CHUNK_OVERLAP=400

# PostgreSQL (internal-api only)
POSTGRES_DB=datacontext
POSTGRES_USER=dcs
POSTGRES_PASSWORD=dcs_password
DATABASE_URL=postgresql+asyncpg://dcs:dcs_password@postgres:5432/datacontext
